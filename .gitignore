# ==========================================
# 作業系統暫存檔 (OS Metadata)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ==========================================
# 編輯器與 IDE 設定檔 (Editors & IDEs)
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# ==========================================
# LaTeX 編譯暫存檔 (若有使用 LaTeX/Tikz 排版)
# ==========================================
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
